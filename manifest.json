{
  "manifest_version": 3,
  "name": "Primera Vista · Auditor SEO y E-E-A-T",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "description": "Auditoría local de SEO, estructura, rendimiento web, E-E-A-T y señales GEO/AEO con identidad Primera Vista y resaltado visual.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Primera Vista · Analizar esta página",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
